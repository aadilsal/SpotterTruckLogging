# Copy to backend/.env and fill in your values.

# --- Required in production (the app refuses to boot without them) ---

# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-secret

# Routing/geocoding. https://openrouteservice.org/dev/#/signup
# Without this the API returns MOCK distances, which would produce fabricated
# HOS compliance verdicts — so a non-DEBUG boot without it is a hard error.
ORS_API_KEY=your-openrouteservice-api-key

# --- Core ---

# Defaults to false. Set true ONLY for local development.
DEBUG=true

ALLOWED_HOSTS=localhost,127.0.0.1

# Local Postgres (docker compose up -d db exposes 5434)
POSTGRES_DB=eld_planner
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434

# Render / cloud: set this instead of the POSTGRES_* vars above
# DATABASE_URL=postgresql://user:password@host:5432/eld_planner

# --- CORS / CSRF (set after the frontend is deployed) ---
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app

# Used to build password-reset links — must point at the frontend, not the API.
FRONTEND_URL=http://localhost:5173

# --- Email (password reset). Omit EMAIL_HOST to print reset links to the console ---
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@spottertrucklogger.app

# --- Optional tuning ---
# LOG_LEVEL=INFO
# DB_CONN_MAX_AGE=60
# THROTTLE_ANON=60/hour
# THROTTLE_USER=1000/hour
# THROTTLE_AUTH=10/hour
# THROTTLE_TRIP_CREATE=60/hour
# SECURE_SSL_REDIRECT=true
# Acknowledge mock routing in a non-production environment without a real key
# ALLOW_MOCK_ROUTING=false
